+
+
+def throughput_mib_s(samples: Sequence[int], seconds: float) -> float:
+    """Average throughput in mebibytes per second.
+
+    Mebibytes, not mebibits: tests/test_stats.py pins 2 MiB over 2 s to 1.0.
+    Returns 0.0 for a non-positive window rather than dividing by zero.
+    """
+    if seconds <= 0:
+        return 0.0
+    return to_mebibytes(total_bytes(samples)) / seconds
